{
  "manifest_version": 3,
  "name": "Folio",
  "version": "1.0.0",
  "description": "Your personal new-tab dashboard. Save pages, map your sites, plan your week.",
  "permissions": ["tabs", "activeTab", "storage", "history", "alarms", "notifications"],
  "host_permissions": ["https://api.deepseek.com/*", "https://open.feishu.cn/*"],
  "commands": {
    "save-current-tab": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Save current page to Folio Saved"
    }
  },
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Folio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
